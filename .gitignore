# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.pnpm-store
/.pytest_cache
__pycache__/
*.py[cod]
.pytest_cache/
backend/__pycache__
backend/*/__pycache__
scripts/__pycache__
tests_py/__pycache__/

# python build/cache artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist-packages/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.pytest_cache/

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem
*.tsbuildinfo

# local service logs (scripts/run_local.py)
logs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/outputs/
/work/
# 模拟账户状态持久化到 Git，行情缓存不跟踪
/.quant-state/*
!/.quant-state/accounts/
/.quant-state/accounts/*
!/.quant-state/accounts/*.txt
/.venv/
/.npm-cache/
/.pip-cache/
/backend/data/cache/
/backend/data/simulation/
