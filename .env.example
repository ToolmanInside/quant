# Quant Lab 环境变量模板
# 复制为 .env 后填写真实值：cp .env.example .env

# Tushare Pro Token（必填，https://tushare.pro 个人主页获取）
TUSHARE_TOKEN=

# 博查新闻搜索 API Key（news_research.enabled=true 时需要）
BOCHA_API_KEY=

# 企业微信机器人 Webhook（notification.provider=wechat 时需要）
WECHAT_WEBHOOK_URL=

# 飞书自定义机器人 Webhook（notification.provider=feishu 时需要）
# 群设置 -> 群机器人 -> 添加机器人 -> 自定义机器人
FEISHU_WEBHOOK_URL=
# 以下两项与飞书机器人安全设置对应，未开启则留空
FEISHU_WEBHOOK_SECRET=
FEISHU_WEBHOOK_KEYWORD=
