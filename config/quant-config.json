{
  "market_data": {
    "provider": "tushare",
    "tushare_token": "${TUSHARE_TOKEN}"
  },
  "market_universe": {
    "mode": "full_market",
    "minimum_listing_days": 180,
    "minimum_daily_amount": 50000000,
    "detailed_candidate_count": 40,
    "top_sector_count": 8,
    "max_candidates_per_sector": 6,
    "always_include_symbols": [],
    "factor_weights": {
      "valuation": 0.2,
      "quality": 0.25,
      "turnover": 0.15,
      "fund_flow": 0.2,
      "liquidity": 0.1,
      "price_strength": 0.1
    }
  },
  "news_research": {
    "enabled": true,
    "provider": "bocha",
    "api_key": "${BOCHA_API_KEY}",
    "freshness": "oneWeek",
    "results_per_query": 5,
    "max_sectors": 3,
    "max_stocks": 8,
    "factor_weight": 0.05,
    "timeout_seconds": 20
  },
  "schedule": {
    "timezone": "Asia/Shanghai",
    "position_report_at": "12:00",
    "daily_close_at": "18:00"
  },
  "paper_account": {
    "account_id": "github-actions",
    "strategy_id": "moving_average",
    "risk_profile": "aggressive",
    "minimum_invested_ratio": 0.70,
    "frequency": "1d",
    "symbols": [
      "159611.SZ",
      "002317.SZ",
      "600183.SH",
      "603738.SH",
      "600367.SH",
      "000811.SZ",
      "002714.SZ",
      "300308.SZ",
      "300502.SZ",
      "688498.SH",
      "300394.SZ",
      "002371.SZ",
      "688008.SH"
    ],
    "backtest_start_date": "2024-01-01",
    "backtest_end_date": "2025-12-31",
    "simulation_start_date": "2026-07-30",
    "initial_cash": 100000,
    "reinitialize_on_config_change": true
  },
  "storage": {
    "state_directory": ".quant-state/accounts",
    "midday_report_path": "outputs/midday-position-report.md",
    "report_path": "outputs/daily-paper-report.md"
  },
  "notification": {
    "provider": "feishu",
    "wechat_enabled": true,
    "wechat_webhook_url": "${WECHAT_WEBHOOK_URL}",
    "feishu_webhook_url": "${FEISHU_WEBHOOK_URL}",
    "feishu_webhook_secret": "${FEISHU_WEBHOOK_SECRET}",
    "feishu_webhook_keyword": "${FEISHU_WEBHOOK_KEYWORD}",
    "timeout_seconds": 20,
    "retry_count": 2
  },
  "report": {
    "title": "Quant Lab 模拟盘日终报告",
    "midday_title": "Quant Lab 午间盘位报告",
    "max_holdings": 20,
    "include_reflection": true
  }
}
