{
  "market_data": {
    "provider": "tushare",
    "tushare_token": "${TUSHARE_TOKEN}"
  },
  "schedule": {
    "timezone": "Asia/Shanghai",
    "position_report_at": "12:00",
    "daily_close_at": "18:00",
    "run_every_day": true
  },
  "paper_account": {
    "account_id": "github-actions",
    "strategy_id": "moving_average",
    "frequency": "1d",
    "symbols": [
      "159611.SZ",
      "002317.SZ",
      "600183.SH",
      "603738.SH",
      "600367.SH",
      "000811.SZ",
      "002714.SZ",
      "300308.SZ",
      "300502.SZ",
      "688498.SH",
      "300394.SZ",
      "002371.SZ",
      "688008.SH"
    ],
    "backtest_start_date": "2024-01-01",
    "backtest_end_date": "2025-12-31",
    "simulation_start_date": "2026-01-01",
    "initial_cash": 500000
  },
  "storage": {
    "state_directory": ".quant-state/accounts",
    "midday_report_path": "outputs/midday-position-report.md",
    "report_path": "outputs/daily-paper-report.md"
  },
  "notification": {
    "wechat_enabled": true,
    "wechat_webhook_url": "${WECHAT_WEBHOOK_URL}",
    "timeout_seconds": 20,
    "retry_count": 2
  },
  "report": {
    "title": "Quant Lab 模拟盘日终报告",
    "midday_title": "Quant Lab 午间盘位报告",
    "max_holdings": 5,
    "max_plans": 5,
    "include_reflection": true
  }
}
